# ==============================================================================
# NomadIQ - Environment Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Sessions
SECRET_KEY=change-me-in-production-use-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nomadiq

# Redis Caching & Event Bus
REDIS_URL=redis://localhost:6379/0

# LLM Providers & Models (Model Router Settings)
OPENAI_API_KEY=your-key-here
MODEL_SIMPLE=gpt-4o-mini
MODEL_MODERATE=gpt-4o-mini
MODEL_COMPLEX=gpt-4o
MODEL_EVALUATION=gpt-4o-mini

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LangSmith Observability
LANGSMITH_API_KEY=your-key-here
LANGSMITH_PROJECT=nomadiq
LANGSMITH_TRACING_V2=true

# Cost Governance
BUDGET_LIMIT_USD=10.0

# Search & Retrieval Weights
DENSE_RETRIEVAL_WEIGHT=0.7
BM25_RETRIEVAL_WEIGHT=0.3

# Business & Operational SLO Constraints
MAX_BUDGET_USD=10000.0
MAX_ITINERARY_DAYS=14
MAX_ACTIVITIES_PER_DAY=6
WALK_THRESHOLD_KM=2.0
MAX_WALK_KM=10.0

# CORS
CORS_ORIGINS=["http://localhost:3000"]
